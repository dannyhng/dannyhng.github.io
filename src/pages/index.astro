---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Danny Hoang | Networking | Infrastructure | Automation">

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-logo">DH<span>.</span></a>
      <div class="nav-links">
        <a href="#projects" class="nav-link" data-section="projects">Projects</a>
        <a href="#philosophy" class="nav-link" data-section="philosophy">Mindset</a>
        <a href="#skills" class="nav-link" data-section="skills">Skills</a>
        <a href="#contact" class="nav-link" data-section="contact">Contact</a>
        <a href="https://www.linkedin.com/in/vietthuhoang/" target="_blank" rel="noopener noreferrer" class="nav-btn">LinkedIn</a>
      </div>
    </div>
  </nav>

  <main>
    <!-- ─── HERO ─────────────────────────────────────────────── -->
    <header class="hero">
      <canvas id="networkCanvas"></canvas>
      <div class="hero-container reveal">
        <div class="avatar-wrapper">
          <div class="avatar-ring">
            <img src="/images/profile-photo.jpg" alt="Danny Hoang" class="hero-avatar" />
          </div>
        </div>
        <div class="hero-content">
          <h1>Hi, I'm <span class="highlight">Danny Hoang</span></h1>
          <p class="tagline"><span id="typewriter"></span><span class="cursor">|</span></p>
          <div class="badge-row">
            <a href="https://www.credly.com/earner/earned/badge/bac2d763-b0a7-43b0-a474-4feee6887ff3" target="_blank" class="badge-link">
              <span class="badge">CCNA Certified</span>
            </a>
            <a href="https://www.credly.com/earner/earned/badge/8779ae6c-8125-4b52-9319-59306e1958e0" target="_blank" class="badge-link">
              <span class="badge">Security+</span>
            </a>
            <a href="https://www.credly.com/earner/earned/badge/b9c68784-f501-4e13-ae66-e99de2c2fef8" target="_blank" class="badge-link">
              <span class="badge">A+</span>
            </a>
          </div>
          <p class="hero-bio">
            I build and experiment with network infrastructure, from Cisco lab topologies to
            containerized services running on Linux servers. My goal is to understand how systems actually
            work, from the physical network up through the applications that run on it.
          </p>
        </div>
      </div>
    </header>

    <!-- ─── PROJECTS ─────────────────────────────────────────── -->
    <section id="projects" class="projects-section">
      <div class="section-header reveal">
        <h2>Technical Projects</h2>
      </div>
      <div class="project-grid">
        <div class="project-card featured reveal">
          <div class="card-content">
            <div class="card-header">
              <span class="category">Primary Lab / Infrastructure</span>
              <h3>Hybrid Homelab Infrastructure</h3>
            </div>
            <div class="img-container">
              <img src="/images/homelab-diagram.png" alt="Network diagram of hybrid homelab infrastructure" class="project-img" />
            </div>
            <div class="tags">
              <span>Proxmox</span><span>Ansible</span><span>Docker</span><span>Tailscale</span>
            </div>
            <p class="project-description">
              Migrated my homelab from manual configuration ("ClickOps") to Infrastructure as Code.
              Designed a split topology that isolates core network services from compute workloads.
            </p>
            <a href="https://github.com/dannyhng/hybrid-homelab-infrastructure" target="_blank" rel="noopener noreferrer" class="project-link">View Documentation →</a>
          </div>
        </div>

        <div class="project-card featured reveal">
          <div class="card-content">
            <div class="card-header">
              <span class="category">Interactive Engineering Tool</span>
              <h3>Network Blueprint Advisor</h3>
            </div>
            <div class="img-container">
              <img src="/images/interactive-website.png" alt="Network Blueprint Advisor Interface" class="project-img" />
            </div>
            <div class="tags">
              <span>Systems Architecture</span><span>Logic Engine</span><span>Vanilla JS</span><span>Astro</span>
            </div>
            <p class="project-description">
              A web application that takes inputs like budget, device count, and availability requirements,
              and turns them into realistic network designs. Exports as PDF or Markdown.
            </p>
            <div class="link-row">
              <a href="https://dannyhng.github.io/network-advisor/" target="_blank" rel="noopener noreferrer" class="project-link">Launch Tool →</a>
              <a href="https://github.com/dannyhng/network-advisor" target="_blank" rel="noopener noreferrer" class="project-link">View Documentation →</a>
            </div>
          </div>
        </div>

        <div class="project-card reveal">
          <div class="card-content">
            <div class="card-header">
              <span class="category">ISP / Service Provider</span>
              <h3>MPLS L3VPN Backbone</h3>
            </div>
            <div class="img-container">
              <img src="/images/mpls-lab.png" alt="MPLS L3VPN lab topology diagram" class="project-img" />
            </div>
            <div class="tags">
              <span>MPLS</span><span>MP-BGP</span><span>VRFs</span><span>EVE-NG</span>
            </div>
            <p>Built an MPLS backbone in my lab to simulate an ISP environment with VRF-based tenant isolation.</p>
            <a href="https://github.com/dannyhng/isp-mpls-l3vpn-lab" target="_blank" rel="noopener noreferrer" class="project-link">View Documentation →</a>
          </div>
        </div>

        <div class="project-card reveal">
          <div class="card-content">
            <div class="card-header">
              <span class="category">Enterprise Networking</span>
              <h3>Enterprise Network Topology Lab</h3>
            </div>
            <div class="img-container">
              <img src="/images/ccna-lab.png" alt="CCNA enterprise lab topology" class="project-img" />
            </div>
            <div class="tags">
              <span>OSPF</span><span>HSRP</span><span>WLC</span><span>ACLs</span>
            </div>
            <p>Built an enterprise-style lab covering major CCNA topics like VLAN segmentation,
              dynamic routing (OSPF), and high-availability (HSRP).</p>
            <a href="https://github.com/dannyhng/ccna-full-config-lab" target="_blank" rel="noopener noreferrer" class="project-link">View Documentation →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── PHILOSOPHY ────────────────────────────────────────── -->
    <section id="philosophy" class="philosophy-section reveal">
      <h2>The Logic Behind the Build</h2>
      <div class="philosophy-content">
        <div class="philosophy-image-wrapper">
          <img src="/images/car.jpeg" alt="Hands-on troubleshooting mindset" class="philosophy-img" />
        </div>
        <div class="philosophy-text">
          <p>Long before I was configuring switches, I was in the garage trying to figure out why something wasn't working.
            Working on cars taught me something that no certification ever could. In any complex system, the problem
            is rarely where you expect it to be. It's the small things. A loose ground. A vacuum leak.
            A connection that looks fine until you actually pull on it.</p>
          <p>Finding those issues takes patience and a methodical approach, especially when everything appears normal.
            That's the part most people skip. They see green lights and assume nothing is wrong.
            But the problems that matter most are often the quiet ones. No errors. No outages. Nothing obvious.
            The only way to find them is to look deeper.</p>
          <p>That same instinct is what drew me to networking. Reaching for a diagnostic scanner on a car that seems
            fine is no different from running a packet capture on a network that seems stable. Both are the same
            skill: separating signal from noise, narrowing the scope, and trusting the process over assumptions.</p>
          <p>Cars and networks aren't that different. They're layered systems that demand respect for the fundamentals
            and reward the person who understands not just what each component does, but how everything fits together.</p>
        </div>
      </div>
    </section>

    <!-- ─── SKILLS ─────────────────────────────────────────────── -->
    <section id="skills" class="skills-section">
      <div class="section-header reveal">
        <h2>Core Stack</h2>
      </div>
      <div class="skills-container">
        <div class="skill-box reveal">
          <h4>Networking</h4>
          <p>OSPF, BGP, MPLS, VLANs, VPN (Tailscale), Cisco IOS, pfSense</p>
        </div>
        <div class="skill-box reveal">
          <h4>Automation</h4>
          <p>Python (Netmiko), Ansible, Terraform, PowerShell, Bash, Git</p>
        </div>
        <div class="skill-box reveal">
          <h4>Infrastructure</h4>
          <p>Proxmox VE, Docker, Microsoft Entra ID, Windows Server 2022</p>
        </div>
      </div>
    </section>

    <!-- ─── EDUCATION ─────────────────────────────────────────── -->
    <section id="education" class="education-section">
      <div class="section-header reveal">
        <h2>Education & Growth</h2>
      </div>
      <div class="education-grid">
        <div class="education-card reveal">
          <div class="edu-status">Completed</div>
          <div class="edu-content">
            <h3>A.S. in Computer Science</h3>
            <p class="school">Mt. Hood Community College</p>
            <p class="edu-detail">Graduated December 2025. Focused on Software Development, Data Structures, and Networking fundamentals.</p>
          </div>
        </div>
        <div class="education-card incoming reveal">
          <div class="edu-status">Incoming</div>
          <div class="edu-content">
            <h3>B.S. in Network Engineering & Security</h3>
            <p class="school">Western Governors University</p>
            <p class="edu-detail">Focusing on Cloud Security, Enterprise Networking, and advanced Infrastructure as Code (IaC) architectures.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── CONTACT ───────────────────────────────────────────── -->
    <section id="contact" class="contact-section reveal">
      <div class="contact-container">
        <h2>Get in Touch</h2>
        <p class="contact-sub">Open to network engineering, infrastructure, and DevOps opportunities.</p>
        <div class="contact-links">
          <a href="mailto:thuvhoang19@gmail.com" class="contact-card">
            <span class="contact-icon">✉</span>
            <span>thuvhoang19@gmail.com</span>
          </a>
          <a href="https://www.linkedin.com/in/vietthuhoang/" target="_blank" rel="noopener noreferrer" class="contact-card">
            <span class="contact-icon">in</span>
            <span>linkedin.com/in/vietthuhoang</span>
          </a>
          <a href="https://github.com/dannyhng" target="_blank" rel="noopener noreferrer" class="contact-card">
            <span class="contact-icon">GH</span>
            <span>github.com/dannyhng</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-content">
      <p>© 2026 Danny Hoang | Portland, OR</p>
    </div>
  </footer>
</Layout>

<style>
  /* ── TOKENS ──────────────────────────────────────────────────── */
  :root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --primary-glow: rgba(37, 99, 235, 0.35);
    --bg: #ffffff;
    --text-main: #111827;
    --text-muted: #4b5563;
    --border: #e5e7eb;
    --card-bg: #f9fafb;

    --font-display: 'Inter', system-ui, sans-serif;
    --font-body: 'Inter', system-ui, sans-serif;
    --font-mono: 'Inter', system-ui, sans-serif;
  }

  body {
    background-color: var(--bg);
    margin: 0;
    scroll-behavior: smooth;
  }

  /* ── SCROLL REVEAL ───────────────────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── NAVBAR ──────────────────────────────────────────────────── */
  .navbar {
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
    position: sticky;
    top: 0;
    background: rgba(255,255,255,0.88);
    backdrop-filter: blur(14px);
    z-index: 100;
    transition: box-shadow 0.3s;
  }
  .navbar.scrolled { box-shadow: 0 2px 20px rgba(0,0,0,0.07); }
  .nav-container { max-width: 1000px; margin: auto; display: flex; justify-content: space-between; align-items: center; padding: 0 1.5rem; }
  .nav-logo { font-weight: 900; font-size: 1.5rem; color: var(--text-main); text-decoration: none; letter-spacing: -0.03em; }
  .nav-logo span { color: var(--primary); }
  .nav-links { display: flex; gap: 2rem; align-items: center; }
  .nav-link { text-decoration: none; color: var(--text-muted); font-weight: 500; font-size: 0.9rem; position: relative; padding-bottom: 3px; transition: color 0.2s; }
  .nav-link::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 2px; background: var(--primary); border-radius: 2px; transition: width 0.25s ease; }
  .nav-link:hover, .nav-link.active { color: var(--primary); }
  .nav-link.active::after, .nav-link:hover::after { width: 100%; }
  .nav-btn { background: var(--text-main); color: white !important; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; font-size: 0.9rem; text-decoration: none; transition: background 0.2s, transform 0.2s; }
  .nav-btn:hover { background: var(--primary); transform: translateY(-1px); }

  main { max-width: 1000px; margin: auto; padding: 0 1.5rem; }

  /* ── HERO ────────────────────────────────────────────────────── */
  .hero {
    padding: 8rem 0;
    position: relative;
    overflow: hidden;
  }
  #networkCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.45;
  }
  .hero-container {
    display: flex;
    align-items: center;
    gap: 4rem;
    position: relative;
    z-index: 1;
  }
  .avatar-wrapper { flex-shrink: 0; }
  .avatar-ring { display: inline-block; }
  .hero-avatar {
    width: 210px;
    height: 210px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    border: 5px solid var(--primary);
    box-shadow: 0 15px 35px rgba(37, 99, 235, 0.15);
  }

  h1 {
    font-size: 4rem;
    font-weight: 900;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .highlight { color: var(--primary); }

  .tagline {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-top: 0.75rem;
    font-weight: 400;
    min-height: 1.6em;
  }
  .cursor {
    display: inline-block;
    color: var(--primary);
    animation: blink 0.9s step-end infinite;
    font-weight: 300;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  .badge-row { display: flex; gap: 0.75rem; margin: 1.5rem 0; flex-wrap: wrap; }
  .badge-link { text-decoration: none; transition: transform 0.2s; }
  .badge-link:hover { transform: translateY(-3px); }
  .badge {
    background: #eff6ff;
    color: var(--primary);
    padding: 0.35rem 1rem;
    border-radius: 99px;
    font-size: 0.82rem;
    font-weight: 700;
    border: 1px solid #dbeafe;
    transition: box-shadow 0.2s, background 0.2s;
  }
  .badge-link:hover .badge {
    box-shadow: 0 0 12px var(--primary-glow);
    background: #dbeafe;
  }
  .hero-bio { font-size: 1.1rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 0; }

  /* ── PROJECTS ────────────────────────────────────────────────── */
  .projects-section { margin-top: 6rem; }
  .section-header { margin: 4rem 0 2rem 0; }
  .section-header h2 {
    font-size: 2.5rem;
    font-weight: 900;
    margin-bottom: 0.5rem;
    }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem; }
  .project-card.featured { grid-column: span 2; }

  .project-card {
    border: 1px solid var(--border);
    border-radius: 20px;
    background: white;
    transition: transform 0.4s cubic-bezier(.22,.68,0,1.2), box-shadow 0.4s, border-color 0.3s;
    position: relative;
    overflow: hidden;
  }
  .project-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    opacity: 0;
    background: radial-gradient(600px circle at var(--mouse-x,50%) var(--mouse-y,50%), var(--primary-glow), transparent 50%);
    transition: opacity 0.4s;
    pointer-events: none;
    z-index: 0;
  }
  .project-card:hover::before { opacity: 1; }
  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 60px -10px rgba(37,99,235,0.18), 0 0 0 1px var(--primary);
    border-color: var(--primary);
  }
  .project-card.featured { border-left: 6px solid var(--primary); }

  .card-content { padding: 3rem; position: relative; z-index: 1; }
  .card-header { margin-bottom: 0.5rem; }
  .category {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .card-content h3 {
    font-size: 1.7rem;
    font-weight: 800;
    margin: 0.3rem 0 0 0;
    letter-spacing: -0.03em;
    color: var(--text-main);
  }
  .img-container {
    background: #fdfdfd;
    border-radius: 14px;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .project-img { width: 100%; height: auto; max-height: 500px; object-fit: contain; transition: transform 0.5s ease; }
  .project-card:hover .project-img { transform: scale(1.015); }

  .tags { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1.25rem; }
  .tags span {
    font-size: 0.75rem;
    background: var(--card-bg);
    padding: 0.3rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    font-weight: 700;
    color: var(--text-muted);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .project-card:hover .tags span { background: #eff6ff; color: var(--primary); border-color: #dbeafe; }

  .project-link {
    display: inline-block;
    font-weight: 700;
    color: var(--primary);
    text-decoration: none;
    margin-top: 1.25rem;
    font-size: 0.95rem;
    position: relative;
    padding-bottom: 2px;
  }
  .project-link::after { content: ''; position: absolute; bottom: 0; left: 0; width: 0; height: 2px; background: var(--primary); transition: width 0.25s; }
  .project-link:hover::after { width: 100%; }
  .link-row { display: flex; gap: 2rem; margin-top: 1.25rem; }
  .link-row .project-link { margin-top: 0; }

  /* ── PHILOSOPHY ──────────────────────────────────────────────── */
  .philosophy-section {
    margin: 10rem 0;
    padding: 5rem;
    background: var(--text-main);
    color: white;
    border-radius: 32px;
    overflow: hidden;
    position: relative;
  }
  /* subtle grid texture on dark bg */
  .philosophy-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(37,99,235,0.04) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(37,99,235,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
  }
  .philosophy-section h2 {
    color: var(--primary);
    font-size: 2.75rem;
    margin-top: 0;
    margin-bottom: 2.5rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    position: relative;
  }
  .philosophy-content { line-height: 1.7; position: relative; }
  .philosophy-image-wrapper { float: right; width: 300px; margin-left: 3rem; margin-bottom: 1.5rem; }
  .philosophy-img {
    width: 100%;
    border-radius: 20px;
    border: 3px solid var(--primary);
    box-shadow: 20px 20px 0px rgba(37, 99, 235, 0.2);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }
  .philosophy-img:hover {
    transform: translateY(-4px) rotate(-1deg);
    box-shadow: 24px 24px 0px rgba(37,99,235,0.3);
  }
  .philosophy-text p { font-size: 1.1rem; opacity: 0.85; margin-bottom: 1.5rem; }

  /* ── SKILLS ──────────────────────────────────────────────────── */
  .skills-section { margin-top: 4rem; }
  .skills-container { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 4rem; }
  .skill-box {
    padding: 2.5rem;
    background: var(--card-bg);
    border-radius: 20px;
    border: 1px solid var(--border);
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
  }
  .skill-box:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(37,99,235,0.1);
    border-color: var(--primary);
  }
  .skill-box h4 {
    margin: 0 0 1.25rem 0;
    color: var(--primary);
    font-size: 1.2rem;
    font-weight: 800;
    border-bottom: 3px solid var(--primary);
    display: inline-block;
    padding-bottom: 0.4rem;
  }
  .skill-box p {
    font-size: 1rem;
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* ── EDUCATION ───────────────────────────────────────────────── */
  .education-section { margin: 6rem 0; }
  .education-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .education-card {
    padding: 2.5rem;
    background: var(--card-bg);
    border-radius: 20px;
    border: 1px solid var(--border);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .education-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.07); }
  .education-card.incoming { border-style: dashed; border-color: var(--primary); background: #f0f7ff; }
  .edu-status {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    background: #e5e7eb;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .incoming .edu-status { background: var(--primary); color: white; }
  .education-card h3 {
    margin: 0;
    font-size: 1.4rem;
    color: var(--text-main);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .school { font-weight: 700; color: var(--primary); margin: 0.25rem 0 1rem 0; font-size: 0.95rem; }
  .edu-detail { font-size: 1rem; color: var(--text-muted); line-height: 1.6; margin: 0; }

  /* ── CONTACT ─────────────────────────────────────────────────── */
  .contact-section { margin: 4rem 0 8rem 0; }
  .contact-container { text-align: center; }
  .contact-container h2 {
    font-size: 2.5rem;
    font-weight: 900;
    margin-bottom: 0.75rem;
    letter-spacing: -0.04em;
  }
  .contact-sub { font-size: 1.1rem; color: var(--text-muted); margin-bottom: 3rem; }
  .contact-links { display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text-main);
    font-weight: 500;
    font-size: 0.95rem;
    transition: border-color 0.2s, color 0.2s, transform 0.2s, box-shadow 0.2s;
    background: white;
  }
  .contact-card:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px var(--primary-glow);
  }
  .contact-icon {
    width: 32px;
    height: 32px;
    background: #eff6ff;
    color: var(--primary);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 800;
  }

  /* ── FOOTER ──────────────────────────────────────────────────── */
  .footer { border-top: 1px solid var(--border); padding: 3rem 0; background: var(--card-bg); }
  .footer-content {
    max-width: 1000px;
    margin: auto;
    padding: 0 1.5rem;
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.85rem;
  }

  /* ── MOBILE ──────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .nav-container { padding: 0 1rem; }
    .nav-logo { font-size: 1.1rem; }
    .nav-links { gap: 0.6rem; }
    .nav-link { font-size: 0.7rem; }
    .nav-btn { display: none; }
    .hero { padding: 3rem 0; }
    .hero-container { flex-direction: column; text-align: center; gap: 1.5rem; }
    .hero-avatar { width: 110px; height: 110px; }
